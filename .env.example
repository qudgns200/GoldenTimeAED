# safetydata.go.kr (공공데이터포털) 인증키
SAFETYDATA_API_KEY=

# Supabase 프로젝트 정보
SUPABASE_URL=
# 백엔드(ETL/FastAPI)에서만 사용 — 절대 프론트엔드나 공개 저장소에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# 스냅샷 생성(backend/scripts/build_snapshot.py)에서 사용. RLS로 SELECT만 허용되므로 공개되어도 안전.
# 프론트엔드 config.js에는 더 이상 들어가지 않는다 — 빌드 시점에만 쓰인다 (docs/OFFLINE_DESIGN.md).
SUPABASE_ANON_KEY=

# 프론트엔드 config.js에 주입되는 값 (네이버 콘솔 웹 서비스 URL 등록으로 보호)
NAVER_MAP_CLIENT_ID=
# 선택. 신규 콘솔 키는 ncpKeyId(기본), 구 콘솔 키는 ncpClientId
NAVER_MAP_AUTH_PARAM=

# GitHub Actions 시크릿으로 등록. ETL 후 Cloudflare Pages 재빌드를 트리거해 스냅샷을 갱신한다.
# 로컬 .env에는 필요 없다.
CLOUDFLARE_DEPLOY_HOOK_URL=

# FastAPI 수동 트리거 엔드포인트 보호용 시크릿 (선택)
ADMIN_TRIGGER_SECRET=

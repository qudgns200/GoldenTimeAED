# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment secrets
# .env.* 를 통째로 무시하되 커밋 대상인 .env.example만 예외로 둔다.
.env
.env.*
!.env.example

# Node (frontend tooling, if any)
node_modules/

# 프론트엔드 런타임 설정 — build-config.sh가 환경변수로부터 생성한다.
# 값 자체는 공개되어도 안전하지만(네이버 콘솔 리퍼러 화이트리스트로 보호) 환경별 분리를 위해 커밋하지 않는다.
frontend/config.js

# frontend/data/(AED 스냅샷)는 일부러 커밋한다.
# push가 곧 Cloudflare Pages 재빌드이므로 Deploy Hook이 필요 없고, 스냅샷이 버전 관리되어
# 롤백과 diff 확인이 쉽다. sync.py가 행 내용이 실제로 바뀐 날에만 파일을 다시 쓰므로
# 매일 10MB가 쌓이지는 않는다 (docs/OFFLINE_DESIGN.md).

# 배포 도구 (Phase 6) — 프로젝트 ID 등 로컬 연결 정보가 들어간다
.vercel/
.wrangler/

# Supabase CLI 로컬 아티팩트
supabase/.temp/
supabase/.branches/


{
  "$schema": "node_modules/wrangler/config-schema.json",

  // 대시보드의 Worker 프로젝트 이름과 반드시 같아야 한다.
  // 다르면 wrangler deploy가 다른 이름의 Worker를 새로 만든다.
  "name": "goldentimeaed",
  "compatibility_date": "2026-08-19",

  // 서버 코드가 없는 순수 정적 사이트다. main(Worker 스크립트)을 두지 않는다.
  "assets": {
    "directory": "./frontend",

    // 이 앱은 클라이언트 라우팅이 없다. 없는 경로는 정직하게 404를 돌려준다.
    //
    // "single-page-application"으로 두면 없는 파일 요청에도 index.html이 200으로
    // 돌아온다. 그러면 sync-data.js가 스냅샷 대신 HTML을 받아 JSON 파싱에서 터지고,
    // 실패 원인이 "파일 없음"이 아니라 "파싱 오류"로 둔갑해 디버깅이 어려워진다.
    "not_found_handling": "none"
  }
}
